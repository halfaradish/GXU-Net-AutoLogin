# 校园网登陆脚本配置示例：复制为 .env 后填写（cp .env.example .env）
# 键名不区分大小写，值可以用引号包起来（PASSWORD="xxx"）
# 用户名：（填写示例：USER=1807210721）
USER=
# 密码：（填写示例：PASSWORD=www.nekopara.uk）
PASSWORD=
# 运营商选择，留空选择校园网，如果需要选择运营商，电信填写telecom，联通填写unicom，移动填写cmcc
NET_TYPE=
# 开启路由器登陆模式：
# 如果填写以下两个参数（均非空），则使用指定的路由器IP和MAC进行认证。
# 否则使用本机IP和MAC。
# 示例：
# ROUTER_IP=172.16.6.6
# ROUTER_MAC=36:88:8A:99:A4:CC
ROUTER_IP=
ROUTER_MAC=
# 手动指定认证用的 MAC：（留空 = 自动使用认证 IP 所在网卡的 MAC）
MAC_ADDRESS=
# 日志：（是否把日志同时写入文件，留空或 false 只打印到控制台）
LOG_TO_FILE=
# 日志文件路径：（留空则使用程序目录下的 logs/GXU_Net_AutoLogin.log）
LOG_FILE=
# ── 以下为托盘版设置，命令行版会忽略 ──
# 开机自启动：
AUTOSTART=false
# 关闭窗口时最小化至托盘：（false = 直接退出程序）
MINIMIZE_TO_TRAY=true
# 启动后不显示主界面：（true = 静默驻留托盘，启动时弹一次气泡；还没填账号时无论如何都会显示主界面）
START_MINIMIZED=true
