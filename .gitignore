# 运行配置与日志不入库：
# .env 里是账号密码与本机/路由器信息，只提交 .env.example 作模板
.env

# 日志：LOG_TO_FILE=true 时生成，含认证 IP / MAC 等信息（默认放在 logs/ 下）
logs/
*.log
*.log.[0-9]*

# 跑 tools/ 里的 Python 脚本时产生的字节码缓存
__pycache__/

# 打包产物：build/ 只放二进制，源码与脚本照常入库
# （tray/rsrc.syso 是编译需要的资源文件，要入库，别跟着 exe 一起忽略）
build/*.exe
# 托盘版正在运行时重新打包，go build 会把换不掉的旧 exe 改名成 xxx.exe~
build/*.exe~
build/GXU_Net_AutoLogin

# 本机开发用的东西不入库：.zcode 是 Agent 工具的工作目录，tools/ 是本机脚本
.zcode/
.zcodeignore
/tools/
